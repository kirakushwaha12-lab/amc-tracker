
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDocument() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveUser() {
      return hasUserDocument()
        && userData().active == true;
    }

    function userRole() {
      return userData().role;
    }

    // Super Admin must have an active Firestore profile
    // with the exact Super Admin role.
    function isSuperAdmin() {
      return isActiveUser()
        && userRole() == "Super Admin";
    }

    function isAdmin() {
      return isActiveUser()
        && userRole() == "Admin";
    }

    function canManageUsers() {
      return isSuperAdmin() || isAdmin();
    }

    function canReadRecords() {
      return isSuperAdmin() || (
        isActiveUser()
        && userRole() in [
          "Admin",
          "Editor",
          "Viewer"
        ]
      );
    }

    function canEditRecords() {
      return isSuperAdmin() || (
        isActiveUser()
        && userRole() in ["Admin", "Editor"]
      );
    }

    function validAdminCreatedUser() {
      return isAdmin()
        && request.resource.data.keys().hasAll([
          "name",
          "email",
          "department",
          "role",
          "active",
          "createdAt",
          "createdBy"
        ])
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "department",
          "role",
          "active",
          "createdAt",
          "createdBy"
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.department is string
        && request.resource.data.role in ["Viewer", "Editor"]
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {

      allow get: if signedIn()
        && (
          request.auth.uid == userId
          || canManageUsers()
        );

      allow list: if canManageUsers();

      allow create: if isSuperAdmin()
        || validAdminCreatedUser();

      allow update, delete: if isSuperAdmin();
    }

    match /app_settings/{settingId} {
      allow get: if isSuperAdmin() || isActiveUser();
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    match /it_devices/{documentId} {
      allow read: if canReadRecords();
      allow create, update: if canEditRecords();
      allow delete: if isSuperAdmin();
    }

    match /vehicles/{documentId} {
      allow read: if canReadRecords();
      allow create, update: if canEditRecords();
      allow delete: if isSuperAdmin();
    }

    match /insurance_policies/{documentId} {
      allow read: if canReadRecords();
      allow create, update: if canEditRecords();
      allow delete: if isSuperAdmin();
    }

    match /compliance_records/{documentId} {
      allow read: if canReadRecords();
      allow create, update: if canEditRecords();
      allow delete: if isSuperAdmin();
    }
  }
}
